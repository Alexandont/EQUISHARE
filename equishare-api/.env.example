# Puerto del servidor
PORT=3000
# Archivo de datos (JSON). Bórralo o ejecuta "npm run seed" para reiniciar los datos demo.
DATA_FILE=data/db.json
# ID del proyecto de Firebase. Si se deja vacío, el servidor funciona en MODO DEMO
# (acepta tokens "demo:<uid>" y no verifica firmas; solo para desarrollo).
FIREBASE_PROJECT_ID=
